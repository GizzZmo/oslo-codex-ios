    "artist_bio": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jon Arve Ovesen has played piano since 1984 and produced since 1994, from Cubase to Nuendo. Oslo Codex carries Eidsvoll and Oslo into a cold, precise Nordic rap-noir frame under Cybergroup Incorporated."
          }
        },
        "nb-NO": {
          "stringUnit": {
            "state": "translated",
            "value": "Jon Arve Ovesen har spilt piano siden 1984 og produsert siden 1994, fra Cubase til Nuendo. I Oslo Codex møtes Eidsvoll og Oslo i et kjølig, presist og nordisk rap-noir-uttrykk signert Cybergroup Incorporated."
          }
        }
      }
    },
